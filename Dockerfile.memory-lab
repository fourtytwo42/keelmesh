FROM python:3.13.7-slim
RUN useradd --system --uid 10002 --create-home memorylab \
 && pip install --no-cache-dir dagster==1.13.20 dagster-webserver==1.13.20 mlflow==3.15.2 boto3==1.40.46 psycopg2-binary==2.9.10
RUN mkdir -p /opt/keelmesh-memory-lab && chown 10002:10002 /opt/keelmesh-memory-lab
WORKDIR /opt/keelmesh-memory-lab
COPY --chown=10002:10002 memorylab ./memorylab
ENV DAGSTER_HOME=/opt/keelmesh-memory-lab/memorylab
USER 10002
