#!/usr/bin/env bash
set -euo pipefail

# M7 fault injection is intentionally limited to the simulated-radio NIC.
# The management/default-route interface must remain reachable at all times.
readonly RADIO_INTERFACE="eth1"
readonly ROLLBACK_UNIT="keelmesh-radio-rollback"

usage() {
  echo "usage: m7-radio-fault <restore|partition|degrade> [eth1]" >&2
  echo "       m7-radio-fault split eth1 <10.77.0.x[,10.77.0.y...]>" >&2
  exit 2
}

action="${1:-}"
requested_interface="${2:-$RADIO_INTERFACE}"
peer_csv="${3:-}"
[[ -n "$action" ]] || usage

if [[ "$requested_interface" != "$RADIO_INTERFACE" ]]; then
  echo "refusing fault: only $RADIO_INTERFACE (simulated radio) may be impaired" >&2
  exit 3
fi

default_interface="$(ip route show default | awk 'NR==1 {print $5}')"
if [[ -z "$default_interface" || "$default_interface" == "$RADIO_INTERFACE" ]]; then
  echo "refusing fault: radio interface is missing or carries the default route" >&2
  exit 4
fi

restore() {
  tc qdisc del dev "$RADIO_INTERFACE" root 2>/dev/null || true
  nft delete table inet keelmesh_radio_fault 2>/dev/null || true
}

arm_rollback() {
  local rollback_instance="${ROLLBACK_UNIT}-$(date +%s)-$$"
  systemd-run --quiet --unit "$rollback_instance" --on-active=60s \
    /usr/local/sbin/m7-radio-fault restore "$RADIO_INTERFACE"
}

case "$action" in
  restore)
    restore
    ;;
  partition)
    arm_rollback
    tc qdisc replace dev "$RADIO_INTERFACE" root netem loss 100%
    ;;
  degrade)
    arm_rollback
    tc qdisc replace dev "$RADIO_INTERFACE" root netem delay 180ms 40ms loss 18% rate 2mbit
    ;;
  split)
    [[ -n "$peer_csv" ]] || usage
    own_radio_ip="$(ip -4 -o addr show dev "$RADIO_INTERFACE" | awk 'NR==1 {split($4,a,"/"); print a[1]}')"
    IFS=',' read -r -a peers <<< "$peer_csv"
    [[ "${#peers[@]}" -ge 1 && "${#peers[@]}" -le 5 ]] || usage
    for peer in "${peers[@]}"; do
      [[ "$peer" =~ ^10\.77\.0\.([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-4])$ ]] || {
        echo "refusing split: peer $peer is outside the simulated-radio subnet" >&2
        exit 5
      }
      [[ "$peer" != "$own_radio_ip" ]] || {
        echo "refusing split: peer list contains this node's radio address" >&2
        exit 6
      }
    done
    arm_rollback
    restore
    nft add table inet keelmesh_radio_fault
    nft 'add chain inet keelmesh_radio_fault output { type filter hook output priority -100; policy accept; }'
    for peer in "${peers[@]}"; do
      nft add rule inet keelmesh_radio_fault output oifname "$RADIO_INTERFACE" ip daddr "$peer" drop
    done
    ;;
  *)
    usage
    ;;
esac

echo "radio_fault=$action interface=$RADIO_INTERFACE management_interface=$default_interface peers=${peer_csv:-all-radio} rollback_seconds=60"
