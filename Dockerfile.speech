FROM python:3.13.7-slim
RUN useradd --system --uid 10002 --create-home keelmesh-speech
WORKDIR /app
COPY speech/requirements.txt ./
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.13.0 \
    && pip install --no-cache-dir -r requirements.txt
COPY speech/keelmesh_speech ./keelmesh_speech
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 KEELMESH_SPEECH_MODEL_ROOT=/models
USER 10002
EXPOSE 8091
CMD ["uvicorn", "keelmesh_speech.service:app", "--host", "0.0.0.0", "--port", "8091", "--no-access-log"]
